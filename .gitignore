# Raw and processed data - too large for git, and re-downloadable
data/raw/*
data/processed/*
!data/raw/**/.gitkeep
!data/processed/.gitkeep

# Trained models - large binary files
models/**/*.joblib
models/**/*.pt
models/**/*.h5
!models/**/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Environment / secrets
.env
kaggle.json

# OS
.DS_Store
